# 1. Базовий образ. Беремо офіційний, але "полегшений" (slim) Python 3.11. 
# Він займає менше місця, ніж повна версія, і містить лише необхідне для роботи.
FROM python:3.11-slim

# 2. Робоча директорія. Створюємо папку /app всередині контейнера і "заходимо" в неї.
# Всі наступні команди будуть виконуватися тут.
WORKDIR /app

# 3. Копіюємо файл із залежностями з твого комп'ютера в контейнер.
# Ми робимо це ОКРЕМО від копіювання коду, щоб Docker міг кешувати бібліотеки.
# Якщо ти зміниш код, йому не доведеться заново качати бібліотеки.
COPY requirements.txt .

# 4. Встановлюємо бібліотеки.
# --no-cache-dir економить місце (не зберігає тимчасові файли після встановлення).
RUN pip install --no-cache-dir -r requirements.txt

# 5. Копіюємо ВЕСЬ інший код (папку app, main.py тощо) в контейнер.
# Перша крапка — це те, що ми копіюємо (все з поточної папки).
# Друга крапка — це куди ми копіюємо (в поточну робочу директорію /app).
COPY . .

# 6. Відкриваємо порт 8000. Це просто інформація для Docker, 
# що контейнер буде слухати цей порт. (Справжнє прокидання портів робиться в docker-compose).
EXPOSE 8000

# 7. Головна команда. Вона запускається, коли контейнер стартує.
# "uvicorn" — це сервер. "app.main:app" — шлях до твого FastAPI додатку.
# "--host 0.0.0.0" — дозволяє підключатися до сервера ззовні (з браузера).
# "--port 8000" — порт, на якому працює сервер.
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]